{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dbvora:contract:p0-03.workspace.v1",
  "title": "DBVORA explicitly selected multi-SQLite workspace metadata",
  "type": "object",
  "required": [
    "contract_version",
    "scope",
    "database_count",
    "table_count",
    "total_main_db_size_bytes",
    "size_scope",
    "cross_database_edges_verified",
    "cross_database_relationships",
    "cpu_usage",
    "ram_usage",
    "databases",
    "relationships",
    "declared_cross_database_links",
    "declared_cross_database_count"
  ],
  "properties": {
    "contract_version": {
      "const": "p0-03.workspace.v1"
    },
    "scope": {
      "const": "explicit_read_only_sqlite_metadata"
    },
    "database_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8
    },
    "table_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "total_main_db_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "size_scope": {
      "const": "sum_of_main_database_files_excludes_wal_and_shm"
    },
    "cross_database_edges_verified": {
      "const": 0
    },
    "cross_database_relationships": {
      "const": "not_inferred"
    },
    "cpu_usage": {
      "const": "unavailable"
    },
    "ram_usage": {
      "const": "unavailable"
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "db_id",
          "label",
          "engine",
          "size_bytes",
          "size_scope",
          "observed_at",
          "provenance",
          "tables",
          "table_storage_scope",
          "table_storage_status"
        ],
        "properties": {
          "db_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "engine": {
            "const": "sqlite"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "size_scope": {
            "const": "main_database_file_only_excludes_wal_and_shm"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "provenance": {
            "type": "object",
            "required": [
              "size_bytes",
              "tables",
              "relationships",
              "cpu_usage",
              "ram_usage",
              "growth_trend"
            ],
            "properties": {
              "size_bytes": {
                "const": "measured_local_filesystem"
              },
              "tables": {
                "const": "measured_sqlite_catalog"
              },
              "relationships": {
                "const": "declared_sqlite_foreign_keys"
              },
              "cpu_usage": {
                "const": "unavailable"
              },
              "ram_usage": {
                "const": "unavailable"
              },
              "growth_trend": {
                "const": "unavailable_needs_multiple_observations"
              }
            },
            "additionalProperties": true
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "columns",
                "foreign_keys",
                "indexes",
                "storage"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "type",
                      "nullable_declared",
                      "pk_position",
                      "hidden"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "nullable_declared": {
                        "type": "boolean"
                      },
                      "pk_position": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "hidden": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": true
                  },
                  "maxItems": 500
                },
                "foreign_keys": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "to_table",
                      "from_columns",
                      "to_columns",
                      "on_update",
                      "on_delete"
                    ],
                    "properties": {
                      "id": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "to_table": {
                        "type": "string",
                        "minLength": 1
                      },
                      "from_columns": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      },
                      "to_columns": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "minItems": 1
                      },
                      "on_update": {
                        "type": "string"
                      },
                      "on_delete": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  },
                  "maxItems": 1000
                },
                "indexes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "unique",
                      "origin",
                      "partial",
                      "key_columns"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unique": {
                        "type": "boolean"
                      },
                      "origin": {
                        "type": "string"
                      },
                      "partial": {
                        "type": "boolean"
                      },
                      "key_columns": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "additionalProperties": true
                  },
                  "maxItems": 1000
                },
                "storage": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "measured",
                        "unavailable"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    },
                    "allocated_btree_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "btree_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "source": {
                      "const": "sqlite_dbstat_aggregate"
                    },
                    "scope": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            },
            "maxItems": 1000
          },
          "table_storage_scope": {
            "type": "string"
          },
          "table_storage_status": {
            "enum": [
              "measured",
              "unavailable"
            ]
          }
        },
        "additionalProperties": true
      },
      "minItems": 2,
      "maxItems": 8
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "database_id",
          "from_table",
          "from_columns",
          "to_table",
          "to_columns",
          "target_in_inventory",
          "evidence"
        ],
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "from_table": {
            "type": "string"
          },
          "from_columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "to_table": {
            "type": "string"
          },
          "to_columns": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "target_in_inventory": {
            "type": "boolean"
          },
          "evidence": {
            "const": "declared_foreign_key"
          }
        },
        "additionalProperties": true
      },
      "maxItems": 1000000
    },
    "declared_cross_database_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_db_id",
          "from_db_label",
          "from_table",
          "from_column",
          "to_db_id",
          "to_db_label",
          "to_table",
          "to_column",
          "evidence",
          "verified"
        ],
        "properties": {
          "from_db_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "from_db_label": {
            "type": "string"
          },
          "from_table": {
            "type": "string"
          },
          "from_column": {
            "type": "string"
          },
          "to_db_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "to_db_label": {
            "type": "string"
          },
          "to_table": {
            "type": "string"
          },
          "to_column": {
            "type": "string"
          },
          "evidence": {
            "const": "user_declared_unverified"
          },
          "verified": {
            "const": false
          }
        },
        "additionalProperties": true
      },
      "maxItems": 64
    },
    "declared_cross_database_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    }
  },
  "additionalProperties": true
}
