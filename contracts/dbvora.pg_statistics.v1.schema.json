{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dbvora:contract:dbvora.pg_statistics.v1",
  "title": "DBVORA PostgreSQL estimated statistics metadata",
  "type": "object",
  "required": [
    "contract",
    "observed_at",
    "statistics_may_lag",
    "freshness_note",
    "tables"
  ],
  "properties": {
    "contract": {
      "const": "dbvora.pg_statistics.v1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "statistics_may_lag": {
      "const": true
    },
    "freshness_note": {
      "type": "string",
      "minLength": 1
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "name",
          "relation_kind",
          "statistics"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "relation_kind": {
            "enum": [
              "r",
              "p",
              "v",
              "m"
            ]
          },
          "statistics": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "unavailable"
                ]
              },
              "reason": {
                "enum": [
                  "pg_statistics_unavailable",
                  "relation_not_in_statistics_view"
                ]
              },
              "estimated_live_rows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854776000
              },
              "estimated_dead_rows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854776000
              },
              "heap_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854776000
              },
              "index_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854776000
              },
              "row_count_provenance": {
                "const": "pg_stat_user_tables_estimate_not_exact"
              },
              "storage_provenance": {
                "const": "pg_relation_size_and_pg_indexes_size"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "maxItems": 300
    }
  },
  "additionalProperties": true
}
