{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dbvora:contract:dbvora.multi_engine_offline.v1",
  "title": "DBVORA offline mixed SQLite and PostgreSQL metadata report",
  "type": "object",
  "required": [
    "contract_version",
    "scope",
    "database_count",
    "table_count",
    "cross_database_edges_verified",
    "cross_database_relationships",
    "cpu_usage",
    "ram_usage",
    "databases",
    "ready_for_customer_data"
  ],
  "properties": {
    "contract_version": {
      "const": "dbvora.multi_engine_offline.v1"
    },
    "scope": {
      "const": "explicit_metadata_only_no_row_data"
    },
    "database_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "table_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "cross_database_edges_verified": {
      "const": 0
    },
    "cross_database_relationships": {
      "const": "not_inferred"
    },
    "cpu_usage": {
      "const": "unavailable"
    },
    "ram_usage": {
      "const": "unavailable"
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "engine",
          "table_count",
          "tables",
          "relationships"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "label": {
            "type": "string"
          },
          "engine": {
            "enum": [
              "sqlite",
              "postgresql"
            ]
          },
          "table_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "name",
                "schema",
                "size_bytes",
                "size_kind",
                "columns",
                "indexes"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "schema": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "size_bytes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "size_kind": {
                  "enum": [
                    "pg_total_relation_size",
                    "unavailable"
                  ]
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "type",
                      "nullable",
                      "primary_key"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "nullable": {
                        "type": "boolean"
                      },
                      "primary_key": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": true
                  },
                  "maxItems": 500
                },
                "indexes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "columns",
                      "unique",
                      "partial"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "columns": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "unique": {
                        "type": "boolean"
                      },
                      "partial": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": true
                  },
                  "maxItems": 1000
                },
                "statistics": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "observed",
                        "unavailable"
                      ]
                    },
                    "reason": {
                      "enum": [
                        "pg_statistics_unavailable",
                        "relation_not_in_statistics_view"
                      ]
                    },
                    "estimated_live_rows": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854776000
                    },
                    "estimated_dead_rows": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854776000
                    },
                    "heap_bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854776000
                    },
                    "index_bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854776000
                    },
                    "row_count_provenance": {
                      "const": "pg_stat_user_tables_estimate_not_exact"
                    },
                    "storage_provenance": {
                      "const": "pg_relation_size_and_pg_indexes_size"
                    }
                  },
                  "additionalProperties": true
                },
                "optimization_review": {
                  "type": "object"
                }
              },
              "additionalProperties": true
            },
            "maxItems": 2000
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "from_columns",
                "to_columns",
                "evidence",
                "verified_across_databases"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "from_columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "to_columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "const": "declared_foreign_key"
                },
                "verified_across_databases": {
                  "const": false
                }
              },
              "additionalProperties": true
            },
            "maxItems": 4000
          }
        },
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 8
    },
    "ready_for_customer_data": {
      "const": false
    }
  },
  "additionalProperties": true
}
