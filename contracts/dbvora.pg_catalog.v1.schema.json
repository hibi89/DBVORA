{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dbvora:contract:dbvora.pg_catalog.v1",
  "title": "DBVORA PostgreSQL read-only catalog metadata",
  "type": "object",
  "required": [
    "contract_version",
    "engine",
    "inspection_mode",
    "observed_at",
    "database_count",
    "table_count",
    "tables",
    "relationships",
    "cpu_usage",
    "ram_usage",
    "ready_for_customer_data"
  ],
  "properties": {
    "contract_version": {
      "const": "dbvora.pg_catalog.v1"
    },
    "engine": {
      "const": "postgresql"
    },
    "inspection_mode": {
      "const": "read_only_metadata_only"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "database_count": {
      "const": 1
    },
    "table_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "name",
          "relation_kind",
          "size_bytes",
          "size_provenance",
          "columns",
          "primary_key_columns",
          "indexes",
          "foreign_keys"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "relation_kind": {
            "enum": [
              "r",
              "p",
              "v",
              "m"
            ]
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "size_provenance": {
            "enum": [
              "pg_total_relation_size",
              "unavailable_not_storage_or_transient"
            ]
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "nullable_declared",
                "attnum"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "type": {
                  "type": "string",
                  "maxLength": 256
                },
                "nullable_declared": {
                  "type": "boolean"
                },
                "attnum": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": true
            },
            "maxItems": 300
          },
          "primary_key_columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 300
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "unique",
                "primary",
                "partial",
                "key_columns"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "unique": {
                  "type": "boolean"
                },
                "primary": {
                  "type": "boolean"
                },
                "partial": {
                  "type": "boolean"
                },
                "key_columns": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "maxItems": 300
                }
              },
              "additionalProperties": true
            },
            "maxItems": 300
          },
          "foreign_keys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "constraint",
                "from_columns",
                "target_in_inventory",
                "to_schema",
                "to_table",
                "to_columns",
                "evidence"
              ],
              "properties": {
                "constraint": {
                  "type": "string",
                  "maxLength": 256
                },
                "from_columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "maxItems": 300
                },
                "target_in_inventory": {
                  "type": "boolean"
                },
                "to_schema": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to_table": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to_columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 300
                },
                "evidence": {
                  "const": "declared_pg_constraint_foreign_key"
                }
              },
              "additionalProperties": true
            },
            "maxItems": 300
          },
          "statistics": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "unavailable"
                ]
              },
              "reason": {
                "enum": [
                  "pg_statistics_unavailable",
                  "relation_not_in_statistics_view"
                ]
              },
              "estimated_live_rows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854776000
              },
              "estimated_dead_rows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854776000
              },
              "heap_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854776000
              },
              "index_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854776000
              },
              "row_count_provenance": {
                "const": "pg_stat_user_tables_estimate_not_exact"
              },
              "storage_provenance": {
                "const": "pg_relation_size_and_pg_indexes_size"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "maxItems": 300
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_schema",
          "from_table",
          "constraint",
          "from_columns",
          "target_in_inventory",
          "to_schema",
          "to_table",
          "to_columns",
          "evidence"
        ],
        "properties": {
          "from_schema": {
            "type": "string"
          },
          "from_table": {
            "type": "string"
          },
          "constraint": {
            "type": "string"
          },
          "from_columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_in_inventory": {
            "type": "boolean"
          },
          "to_schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_table": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "const": "declared_pg_constraint_foreign_key"
          }
        },
        "additionalProperties": true
      },
      "maxItems": 90000
    },
    "cpu_usage": {
      "const": "unavailable"
    },
    "ram_usage": {
      "const": "unavailable"
    },
    "ready_for_customer_data": {
      "const": false
    }
  },
  "additionalProperties": true
}
